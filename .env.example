# Número de WhatsApp da pousada, formato internacional sem espaços/símbolos
# (Brasil = 55 + DDD + número). Usado em todos os botões "Reservar".
NEXT_PUBLIC_WHATSAPP_NUMBER=5563900000000

# Contato exibido no rodapé
NEXT_PUBLIC_CONTACT_EMAIL=contato@pousadadonamaria.com.br
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=(63) 90000-0000

# Localização exibida na seção "Onde Estamos" (mapa embed sem necessidade de API key)
NEXT_PUBLIC_MAPS_LAT=-10.1689
NEXT_PUBLIC_MAPS_LNG=-48.3317
NEXT_PUBLIC_MAPS_ADDRESS="Endereço a confirmar — distrito no interior do Tocantins"

# Opcional: avaliações reais do Google (Places API). Sem essas duas variáveis,
# a seção de avaliações usa os depoimentos de exemplo em src/data/testimonials.ts.
# Nunca prefixar com NEXT_PUBLIC_ — a chave só é usada no servidor.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
